{
  "manifest_version": 3,
  "name": "万能提取 · 小红书 / 抖音 / 视频号 / B站",
  "version": "1.2.1",
  "description": "提取小红书、抖音和视频号内容，支持 B 站音视频合并为完整 MP4；浏览器本地处理。",
  "minimum_chrome_version": "120",
  "permissions": [
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://*.xiaohongshu.com/*",
    "https://*.xhslink.com/*",
    "https://*.douyin.com/*",
    "https://*.iesdouyin.com/*",
    "https://weixin.qq.com/*",
    "https://channels.weixin.qq.com/*",
    "https://yuanbao.tencent.com/*",
    "https://*.video.qq.com/*",
    "https://*.qpic.cn/*",
    "https://wxapp.tc.qq.com/*",
    "https://*.bilibili.com/*",
    "https://b23.tv/*",
    "https://*.bilivideo.com/*",
    "https://*.bilivideo.cn/*",
    "https://*.hdslb.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开万能提取",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.xiaohongshu.com/*",
        "https://*.douyin.com/*",
        "https://*.iesdouyin.com/*"
      ],
      "js": [
        "lib/core.js",
        "capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'"
  }
}
